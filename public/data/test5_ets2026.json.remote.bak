          {
            "question": "196.  What is the purpose of the first e-mail? ",
            "choices": [
              {
                "choice": "A",
                "answer": "To verify an equipment order ",
                "correct": false
              },
              {
                "choice": "B",
                "answer": "To request machinery repair ",

        "sub_questions": [
          {
            "question": "191. What does the article state about collapsible toothpaste tubes?",
            "choices": [
              {
                "choice": "A",
                "answer": "They are difficult to recycle.",
                "correct": true
              },
              {
                "choice": "B",
                "answer": "They are not very popular.",
                "correct": false
              },
              {
                "choice": "C",
                "answer": "They were invented in the United States.",
                "correct": false
              },
              {
                "choice": "D",
                "answer": "They were not included in a survey.",
                "correct": false
              }
            ],
            "correct_answer": "A",
            "explanation_transcript": "<p><strong>191. Bài báo nói gì về các tuýp kem đánh răng có thể gập lại?</strong><br />\n<span style='color: #29b95c;'><strong>(A) Chúng khó tái chế.</strong></span><br />\n(B) Chúng không phổ biến lắm.<br />\n(C) Chúng được phát minh tại Hoa Kỳ.<br />\n(D) Chúng không được đưa vào khảo sát.</p>\n"

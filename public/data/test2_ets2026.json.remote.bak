        "question_id": 87810,
        "sub_questions": [
          {
            "question": "112. During Mr. Nagahori’s tenure as CEO at Unten Properties, the company has grown ______. ",
            "choices": [
              {
                "choice": "A",
                "answer": "signify",
                "correct": false
